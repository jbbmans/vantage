{
  "name": "vantage",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "Enterprise performance, readiness, and career-record application for Marine Corps Unit Instances, built for MCEN hosting.",
  "author": "John Bernard Boletz",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "start": "node server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tests/browser",
    "lint": "eslint . && node scripts/any-budget.ts",
    "test": "node --test --test-concurrency=1 \"tests/server/**/*.test.ts\"",
    "test:browser": "playwright test",
    "film": "npm --prefix film run render --",
    "pretest:browser": "npm run build",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "recover-operator": "node scripts/recover-operator.ts",
    "provision-instance": "node scripts/provision-instance.ts",
    "factory-reset": "node scripts/factory-reset.ts",
    "backup": "node scripts/backup.ts",
    "restore": "node scripts/restore.ts",
    "operations-report": "node scripts/operations-report.ts",
    "icons": "node scripts/icons.mjs",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.104.5",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.6",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.3"
  }
}
