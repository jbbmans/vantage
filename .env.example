# Copy to .env for local work. In production these are set by the platform.

# Port the server listens on. Fly and Render inject their own.
PORT=8787

# Where SQLite lives. In production this MUST point at a mounted volume,
# otherwise a deploy replaces the filesystem and takes the records with it.
VANTAGE_DB=./vantage.db

# Turns on secure cookies and HSTS.
NODE_ENV=development

# Set to "false" only if the app is NOT behind a proxy or load balancer.
# Leaving it on when there is no proxy lets a client spoof its own IP to the
# login throttle.
TRUST_PROXY=true
