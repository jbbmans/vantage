# Local development defaults. Production secrets belong in the host's secret manager.
NODE_ENV=development
# accounts (default): real accounts. demo: the synthetic click-through demonstration with no sign-in.
# demo is refused with NODE_ENV=production, on a database holding real accounts, and with CAC, email,
# AI or the MARADMIN feed turned on. Give it its own database (a new path, or :memory:).
VANTAGE_ACCESS_MODE=accounts
VANTAGE_DEMO_TTL_HOURS=24
VANTAGE_DEMO_MAX_WORKSPACES=200
# Synthetic demo only: forward catalogued usage events (screen and step names, never typed text,
# ids or document numbers) to PostHog. Leave empty to keep everything on this server. Refused
# unless VANTAGE_ACCESS_MODE=demo.
VANTAGE_POSTHOG_KEY=
VANTAGE_POSTHOG_HOST=https://us.i.posthog.com
PORT=8787
VANTAGE_DB=./data/vantage.db
# Public origin of the app (required in production; used for passkeys, email links, cookies).
VANTAGE_PUBLIC_URL=http://localhost:5173
# 32+ random characters. Signs tokens, protects the audit chain, encrypts MFA secrets.
VANTAGE_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# Comma-separated usernames that always hold Instance Operator authority.
VANTAGE_OPERATOR=
# First-run setup secret (required in production).
VANTAGE_SETUP_TOKEN=
# Instance timezone for digests and fiscal dates.
VANTAGE_TIMEZONE=America/New_York
# Trust the first reverse-proxy hop (Render, Fly, Cloudflare). false when the app is exposed directly.
TRUST_PROXY=false

# GenAI.mil gateway. The key never reaches the browser.
VANTAGE_AI_ENABLED=false
VANTAGE_GENAI_API_KEY=
VANTAGE_GENAI_BASE_URL=https://api.genai.mil/v1
VANTAGE_GENAI_MODELS=gemini-2.5-flash

# Email: none | resend | smtp
VANTAGE_EMAIL_PROVIDER=none
VANTAGE_EMAIL_FROM="Vantage <no-reply@vantageusmc.com>"
RESEND_API_KEY=
SMTP_URL=

# Official MARADMIN feed ingestion. Off by default: it fetches from marines.mil, which a restricted
# network may block. Turn it on only where that egress is approved.
VANTAGE_MARADMIN_ENABLED=false
