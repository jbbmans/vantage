NODE_ENV=development
# mcen (the production target), legacy-public (the pre-MCEN public site) or development. Unset: development, or
# legacy-public with a warning when NODE_ENV=production. See docs/deploy-mcen.md and ADR-0007.
# VANTAGE_DEPLOYMENT_PROFILE=development
# shared (many Unit Instances in one database) or dedicated (this deployment holds exactly one).
# VANTAGE_TOPOLOGY=shared
VANTAGE_ACCESS_MODE=accounts
VANTAGE_DEMO_TTL_HOURS=24
VANTAGE_DEMO_MAX_WORKSPACES=200
PORT=8787
VANTAGE_DB=./data/vantage.db
VANTAGE_PUBLIC_URL=http://localhost:5173
# Optional: give the public page, the app, the owner console and the admin dashboard addresses of their own.
# The admin dashboard falls back to the owner console's host, at /admin.
# VANTAGE_SITE_URL=https://www.example.com
# VANTAGE_APP_URL=https://secure.example.com
# VANTAGE_CONSOLE_URL=https://dev.example.com
# VANTAGE_ADMIN_URL=https://admin.example.com
# The domain passkeys belong to; defaults to the one the app and console share.
# VANTAGE_RP_ID=example.com
VANTAGE_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# When changing the secret: the old value here for one start, then remove it (docs/operations.md).
# VANTAGE_SECRET_PREVIOUS=
# Send every audit record off this host as it is written (docs/operations.md#audit-records-off-the-host).
# VANTAGE_AUDIT_SYSLOG=tls://siem.example.mil:6514
# VANTAGE_AUDIT_STDOUT=false
# Comma-separated usernames made Vantage platform owners at every start (ADR-0006).
# VANTAGE_OPERATOR, its name before organizations, still works.
VANTAGE_PLATFORM_OWNERS=
# First-run setup secret (required in production).
VANTAGE_SETUP_TOKEN=
# The service's timezone for digests and fiscal dates (each person can set their own).
VANTAGE_TIMEZONE=America/New_York
TRUST_PROXY=false
# Legacy public site only (refused under mcen). Behind Cloudflare, "cloudflare" takes the visitor's address from CF-Connecting-IP when (and only when) the request
# arrives from a Cloudflare edge address, so rate limits apply per visitor instead of per edge. Default: proxy.
# VANTAGE_CLIENT_IP=cloudflare
# Where security.txt sends vulnerability reports first (mailto: or https:). The request form is always listed.
# VANTAGE_SECURITY_CONTACT=mailto:security@example.mil

# GenAI.mil gateway. The key never reaches the browser.
VANTAGE_AI_ENABLED=false
VANTAGE_GENAI_API_KEY=
VANTAGE_GENAI_BASE_URL=https://api.genai.mil/v1
VANTAGE_GENAI_MODELS=gemini-2.5-flash

# Email: none | direct (your own domain, no service) | resend | smtp. Under mcen: smtp (the enterprise relay) or none.
VANTAGE_EMAIL_PROVIDER=none
VANTAGE_EMAIL_FROM="Vantage <no-reply@vantageusmc.com>"
# Where replies to automatic mail go; direct mode sends but cannot receive.
VANTAGE_EMAIL_REPLY_TO=
# Direct mode only: the DKIM selector (default vantage), and the greeting name if you control reverse DNS.
VANTAGE_DKIM_SELECTOR=
VANTAGE_EMAIL_HELO=
RESEND_API_KEY=
SMTP_URL=

VANTAGE_MARADMIN_ENABLED=false

# Legacy public site only (refused under mcen). Search: ownership tokens from Google Search Console and Bing Webmaster Tools, and IndexNow
# (tells Bing, Edge, DuckDuckGo, Yahoo and Yandex when the public page changes; one outbound request per change).
VANTAGE_GOOGLE_SITE_VERIFICATION=
VANTAGE_BING_SITE_VERIFICATION=
VANTAGE_INDEXNOW=false

VANTAGE_M365_CLIENT_ID=
VANTAGE_M365_CLIENT_SECRET=
# organizations (any work account), a tenant id, or a verified domain.
VANTAGE_M365_TENANT=organizations

# Security controls for an accredited deployment (docs/security.md)
# VANTAGE_CONSENT_BANNER=dod            # the DoD Notice and Consent Banner before sign-in
# VANTAGE_IDLE_MINUTES=15               # VANTAGE_STAFF_IDLE_MINUTES=10 (Vantage staff)
# VANTAGE_LOCKOUT_ATTEMPTS=3            # VANTAGE_LOCKOUT_MINUTES=15
# VANTAGE_CLAMD=tcp://clamd:3310        # scan every upload; VANTAGE_SCAN_REQUIRED=true refuses unscanned files
# VANTAGE_BROWSER_BACKUPS=false         # back up on the server only (npm run backup)
# CAC_CRL_DIR=/etc/vantage/crls         # required with CAC_MODE=direct

# Organization sign-in over OpenID Connect (docs/cac-and-records.md)
# VANTAGE_OIDC_ISSUER=https://login.microsoftonline.us/<tenant id>/v2.0
# VANTAGE_OIDC_CLIENT_ID=
# VANTAGE_OIDC_CLIENT_SECRET=
# VANTAGE_OIDC_LINK=email               # email, edipi (with VANTAGE_OIDC_EDIPI_CLAIM) or none
# VANTAGE_OIDC_AUTO_PROVISION=false     # create accounts for active roster members on first sign-in
# VANTAGE_OIDC_EXCLUSIVE=false          # turn password sign-in off
