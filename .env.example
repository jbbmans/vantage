# Copy to .env for local work. In production these are set by the platform.

# Port the server listens on. Fly and Render inject their own.
PORT=8787

# Where SQLite lives. In production this MUST point at a mounted volume,
# otherwise a deploy replaces the filesystem and takes the records with it.
VANTAGE_DB=./vantage.db

# Turns on secure cookies and HSTS.
NODE_ENV=development

# Set to "false" only if the app is NOT behind a proxy or load balancer.
# Leaving it on when there is no proxy lets a client spoof its own IP to the
# login throttle.
TRUST_PROXY=true

# Production first-run setup is refused without a random value of at least 24
# characters. Keep it in the hosting platform's secret store, not this file.
VANTAGE_SETUP_TOKEN=replace-with-a-long-random-deployment-secret

# Preferred: immutable account UUIDs allowed to perform instance-wide recovery,
# database backup, account reset/deactivation, and top-level unit creation.
# Find your UUID in /api/me after setup, then set this in the platform secret
# store and restart. When set, it takes precedence over VANTAGE_OPERATOR.
VANTAGE_OPERATOR_ID=your-bootstrap-account-uuid

# Compatibility fallback: canonical usernames. Keep only while migrating to
# VANTAGE_OPERATOR_ID; usernames are case-insensitively unique.
VANTAGE_OPERATOR=your-operator-username

# "evaluation" displays a persistent controlled-test-data banner. Change to
# "operational" only after the deployment and data types are authorized.
VANTAGE_DATA_MODE=evaluation

# Local-password session bounds. CAC/PIV integration is a deployment adapter,
# not enabled by these values.
VANTAGE_IDLE_MINUTES=60
VANTAGE_SESSION_HOURS=12
VANTAGE_MAX_SESSIONS=8

# Evaluation safety bounds. Adjust only with capacity monitoring and an
# approved retention plan; these defaults preserve headroom on the 1 GB
# volumes in the included Fly and Render examples.
VANTAGE_MUTATIONS_PER_15_MINUTES=240
VANTAGE_MAX_RECORDS_PER_USER=10000
VANTAGE_MAX_DB_BYTES=786432000
VANTAGE_MAX_GUEST_DAYS=30
