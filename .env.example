# Local defaults. Keep production secrets in the hosting platform.
PORT=8787
VANTAGE_DB=./vantage.db
NODE_ENV=development
TRUST_PROXY=false
VANTAGE_SETUP_TOKEN=replace-with-a-long-random-deployment-secret
VANTAGE_OPERATOR_ID=your-bootstrap-account-uuid
VANTAGE_OPERATOR=your-operator-username
VANTAGE_DATA_MODE=evaluation
VANTAGE_PUBLIC_URL=https://vantageusmc.com
VANTAGE_ADMIN_URL=https://admin.vantageusmc.com
VANTAGE_MARADMIN_ENABLED=true
VANTAGE_MARADMIN_REFRESH_MINUTES=30
VANTAGE_INTEGRATIONS_ENABLED=false
VANTAGE_INTEGRATION_REQUESTS_PER_15_MINUTES=600
VANTAGE_IDLE_MINUTES=60
VANTAGE_SESSION_HOURS=12
VANTAGE_MAX_SESSIONS=8
VANTAGE_MUTATIONS_PER_15_MINUTES=240
VANTAGE_MAX_RECORDS_PER_USER=10000
VANTAGE_MAX_DB_BYTES=786432000
VANTAGE_MAX_GUEST_DAYS=30
