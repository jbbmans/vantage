NODE_ENV=development
VANTAGE_ACCESS_MODE=accounts
VANTAGE_DEMO_TTL_HOURS=24
VANTAGE_DEMO_MAX_WORKSPACES=200
PORT=8787
VANTAGE_DB=./data/vantage.db
VANTAGE_PUBLIC_URL=http://localhost:5173
# Optional: give the public page, the app and the owner console addresses of their own.
# VANTAGE_SITE_URL=https://www.example.com
# VANTAGE_APP_URL=https://secure.example.com
# VANTAGE_CONSOLE_URL=https://dev.example.com
# The domain passkeys belong to; defaults to the one the app and console share.
# VANTAGE_RP_ID=example.com
VANTAGE_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# Comma-separated usernames that always hold Instance Operator authority.
VANTAGE_OPERATOR=
# First-run setup secret (required in production).
VANTAGE_SETUP_TOKEN=
# Instance timezone for digests and fiscal dates.
VANTAGE_TIMEZONE=America/New_York
TRUST_PROXY=false

# GenAI.mil gateway. The key never reaches the browser.
VANTAGE_AI_ENABLED=false
VANTAGE_GENAI_API_KEY=
VANTAGE_GENAI_BASE_URL=https://api.genai.mil/v1
VANTAGE_GENAI_MODELS=gemini-2.5-flash

# Email: none | direct (your own domain, no service) | resend | smtp
VANTAGE_EMAIL_PROVIDER=none
VANTAGE_EMAIL_FROM="Vantage <no-reply@vantageusmc.com>"
# Where replies to automatic mail go; direct mode sends but cannot receive.
VANTAGE_EMAIL_REPLY_TO=
# Direct mode only: the DKIM selector (default vantage), and the greeting name if you control reverse DNS.
VANTAGE_DKIM_SELECTOR=
VANTAGE_EMAIL_HELO=
RESEND_API_KEY=
SMTP_URL=

VANTAGE_MARADMIN_ENABLED=false

# Search: ownership tokens from Google Search Console and Bing Webmaster Tools, and IndexNow
# (tells Bing, Edge, DuckDuckGo, Yahoo and Yandex when the public page changes; one outbound request per change).
VANTAGE_GOOGLE_SITE_VERIFICATION=
VANTAGE_BING_SITE_VERIFICATION=
VANTAGE_INDEXNOW=false

VANTAGE_M365_CLIENT_ID=
VANTAGE_M365_CLIENT_SECRET=
# organizations (any work account), a tenant id, or a verified domain.
VANTAGE_M365_TENANT=organizations
